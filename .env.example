# Copy to .env and adjust. .env is gitignored.

# Local database from docker-compose.yml. These credentials are for local development only.
DATABASE_URL=postgres://flanr:flanr@localhost:5433/flanr

# API
API_PORT=8787
# Write requests per minute and client; 60 when not set (NFR-SEC-004).
# WRITE_RATE_LIMIT=
# Where the web server reaches the API.
API_URL=http://localhost:8787

# Origins of web clients that may call the API from the browser, comma-separated.
CORS_ORIGINS=http://localhost:3000

# Clerk (https://dashboard.clerk.com). Without the secret key the API rejects every sign-in.
# The web app reads this file too (apps/web/next.config.ts). The end-to-end tests need the keys
# of a development instance (sk_test_…), because they create and delete a test user.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret of the Clerk webhook that points to POST /webhooks/clerk.
CLERK_WEBHOOK_SIGNING_SECRET=

# Public token of the Mapbox account (https://console.mapbox.com) for the map. Without it the
# pages show a note instead of the map. The end-to-end tests always run without it.
NEXT_PUBLIC_MAPBOX_TOKEN=
