# Copy to .env and adjust. .env is gitignored.

# Local database from docker-compose.yml. These credentials are for local development only.
DATABASE_URL=postgres://flanr:flanr@localhost:5433/flanr

# API
API_PORT=8787

# Origins of web clients that may call the API from the browser, comma-separated.
CORS_ORIGINS=http://localhost:3000

# Clerk (https://dashboard.clerk.com). Without the secret key the API rejects every sign-in.
CLERK_SECRET_KEY=
# Signing secret of the Clerk webhook that points to POST /webhooks/clerk.
CLERK_WEBHOOK_SIGNING_SECRET=
